# Tiger Cloud → your service → "Connection info" → copy the service URL
DATABASE_URL=postgres://tsdbadmin:YOUR_PASSWORD@YOUR_HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# Miami-Dade realtime is served by Swiftly. Request a key: https://www.miamidade.gov/global/transportation/open-data-feeds.page
GTFS_RT_API_KEY=
# Confirm the exact URL in Swiftly's docs once your key arrives (the agency key may differ from "miami").
GTFS_RT_VEHICLES_URL=https://api.goswift.ly/real-time/miami/gtfs-rt-vehicle-positions
GTFS_RT_AUTH_HEADER=Authorization

POLL_SECONDS=15
AGENCY_TZ=America/New_York

# Where the bus data comes from: auto (realtime if a key is set, else simulated), live, sim, or off.
# Only one server writes at a time anyway (database lock); use off to make this copy view-only.
FEED_MODE=auto
